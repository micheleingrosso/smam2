{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smam2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smam2-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
